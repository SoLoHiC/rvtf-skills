{
  "name": "rvtf-skills",
  "version": "0.4.0",
  "description": "Requirements-to-Verification Traceability Framework skills and adapters.",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "VERSION",
    "skills",
    "scripts/ci.sh",
    "scripts/fixtures",
    "scripts/install.sh",
    "scripts/package.sh",
    "scripts/release.py",
    "scripts/validate-schema-examples.py",
    "scripts/validate.sh",
    "scripts/validate_skills.py"
  ],
  "scripts": {
    "test": "PYTHONPATH=scripts python3 -m unittest discover -s scripts/tests -v",
    "validate": "scripts/validate.sh",
    "validate:skills": "python3 scripts/validate_skills.py",
    "skills:list": "npx skills add . --list",
    "skills:add:project": "npx skills add . --skill '*' -a codex -y --copy",
    "skills:add:global:codex": "npx skills add . --skill '*' -g -a codex -y --copy",
    "package": "scripts/package.sh",
    "ci": "scripts/ci.sh"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "rvtf",
    "requirements",
    "verification",
    "traceability"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SoLoHiC/rvtf-skills.git"
  },
  "homepage": "https://github.com/SoLoHiC/rvtf-skills#readme",
  "bugs": {
    "url": "https://github.com/SoLoHiC/rvtf-skills/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
